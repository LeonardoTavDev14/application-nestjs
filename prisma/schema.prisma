generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum userRoles {
  USER
  ADMIN
  SUPERADMIN
}

model User {
  id       String    @id @default(uuid())
  name     String
  email    String    @unique
  password String
  age      Int
  role     userRoles @default(USER)

  authAttempts     Int?
  suspendedAccount DateTime?
  blockedAccount   Boolean?

  resetTokenPassword   String?
  expiredTokenPassword DateTime?

  refreshToken RefreshToken[]

  created_At DateTime @default(now())
  updated_At DateTime @updatedAt()
}

model RefreshToken {
  id       String    @id @default(uuid())
  userRole userRoles
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
}
